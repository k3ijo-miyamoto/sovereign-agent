{
  "name": "sovereign-agent-vscode",
  "displayName": "Sovereign Agent",
  "description": "Local LLM coding assistant (Ollama / Anthropic)",
  "version": "0.3.0",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sovereignAgent.openChat",
        "title": "Sovereign Agent: Open Chat"
      },
      {
        "command": "sovereignAgent.restart",
        "title": "Sovereign Agent: Restart CLI"
      },
      {
        "command": "sovereignAgent.stop",
        "title": "Sovereign Agent: Stop"
      },
      {
        "command": "sovereignAgent.clear",
        "title": "Sovereign Agent: Clear Chat"
      }
    ],
    "configuration": {
      "title": "Sovereign Agent",
      "properties": {
        "sovereignAgent.provider": {
          "type": "string",
          "enum": ["ollama", "anthropic"],
          "default": "ollama",
          "description": "LLM provider"
        },
        "sovereignAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama base URL"
        },
        "sovereignAgent.model": {
          "type": "string",
          "default": "gemma3:12b",
          "description": "Default text model"
        },
        "sovereignAgent.binaryPath": {
          "type": "string",
          "default": "auto",
          "description": "Path to sovereign binary (auto = search workspace)"
        },
        "sovereignAgent.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Additional system prompt appended to the default"
        },
        "sovereignAgent.taskModel.docstring": {
          "type": "string",
          "default": "",
          "description": "Model for docstring tasks (empty = use default)"
        },
        "sovereignAgent.taskModel.tests": {
          "type": "string",
          "default": "",
          "description": "Model for test generation (empty = use default)"
        },
        "sovereignAgent.taskModel.typeHints": {
          "type": "string",
          "default": "",
          "description": "Model for type annotation tasks (empty = use default)"
        },
        "sovereignAgent.taskModel.commitMsg": {
          "type": "string",
          "default": "",
          "description": "Model for commit message generation (empty = use default)"
        },
        "sovereignAgent.allowedTools": {
          "type": "string",
          "default": "bash,read_file,write_file,list_files",
          "description": "Comma-separated list of tools the agent is allowed to use"
        },
        "sovereignAgent.visionModel": {
          "type": "string",
          "default": "qwen2.5vl:7b",
          "description": "Vision model for image analysis"
        },
        "sovereignAgent.searchEngine": {
          "type": "string",
          "enum": ["duckduckgo", "google", "bing"],
          "default": "duckduckgo",
          "description": "Web search engine"
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
